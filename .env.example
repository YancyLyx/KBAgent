# KBAgent - Environment Variables
# Copy this to .env and fill in your values

# === LLM Configuration ===
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# LLM 请求超时（秒）与 SDK 内置重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# === Optional: Use a different provider for eval judge ===
# Leave empty to fall back to the LLM config above
# Example: use OpenAI's GPT-4o-mini for cheaper evaluation
# EVAL_API_KEY=sk-your-openai-key
# EVAL_BASE_URL=https://api.openai.com/v1
# EVAL_MODEL=gpt-4o-mini
# EVAL_TIMEOUT=30
# EVAL_MAX_RETRIES=2

# === Server ===
# CORS 白名单（逗号分隔）；生产环境务必改为具体域名
# CORS_ORIGINS=https://admin.example.com,https://user.example.com
# 匿名身份 token 签名密钥（阶段0 鉴权）；生产必须设置，否则使用开发密钥
# ANON_TOKEN_SECRET=please-change-me
# 管理端鉴权：用户名/密码（密码支持明文或 pbkdf2 哈希，生产建议哈希）+ token 签名密钥
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# ADMIN_TOKEN_SECRET=please-change-me
# ADMIN_TOKEN_TTL_SECONDS=86400
# 会话空闲回收时间（秒）与最大活跃会话数
# SESSION_IDLE_TTL_SECONDS=1800
# MAX_ACTIVE_SESSIONS=200

# === Storage ===
CHROMA_DB_PATH=./data/chroma_db
